# Firebase Configuration
# Run `flutterfire configure` to generate firebase_options.dart with actual values

FIREBASE_PROJECT_ID=finflow-app
FIREBASE_API_KEY_ANDROID=your-android-api-key
FIREBASE_API_KEY_IOS=your-ios-api-key
FIREBASE_APP_ID_ANDROID=your-android-app-id
FIREBASE_APP_ID_IOS=your-ios-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=finflow-app.appspot.com

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=your-web-client-id
