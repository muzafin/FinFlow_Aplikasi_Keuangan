rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/_accountDeletions/$(uid))
        && (!firestore.exists(/databases/(default)/documents/_dataResets/$(uid)) || firestore.get(/databases/(default)/documents/_dataResets/$(uid)).data.status == 'complete');
    }
    match /users/{uid}/profile/avatar.jpg {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if owner(uid);
    }
    // Ikon dompet kustom: users/{uid}/wallet-icons/{accountId}.jpg, JPEG kecil (klien mengecilkan ke ≤ 64 KB).
    match /users/{uid}/wallet-icons/{file} {
      allow read, delete: if owner(uid) && file.matches('^[A-Za-z0-9_-]{1,93}[.]jpg$');
      allow create, update: if owner(uid) && file.matches('^[A-Za-z0-9_-]{1,93}[.]jpg$')
        && request.resource.size > 0 && request.resource.size <= 100 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
    match /{path=**} { allow read, write: if false; }
  }
}
